# Copy this file to .env and fill in real values before running.
# Never commit a real .env with live secrets to source control.

# --- LLM provider ---
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o
CHAT_MAX_TOKENS=1024

# --- Redis (chat history / session store, 24hr TTL by default) ---
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400
SESSION_TTL_SLIDING=true

# --- Auth: MUST match the JWT config of the main LetsHyre API ---
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Main LetsHyre Core API (candidate/recruiter data lookups) ---
CORE_API_BASE_URL=http://localhost:8000
CORE_API_INTERNAL_TOKEN=

# --- Frontend (used to build recruiter redirect links) ---
FRONTEND_BASE_URL=https://letshyre.com

# --- RAG content (visitor FAQ knowledge base) ---
RAG_CONTENT_PATH=data/faq_content.json

# --- Rate limiting (per identity/IP, sliding window) ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS: comma-separated list of allowed origins ---
ALLOWED_ORIGINS=https://letshyre.com

# --- Dev/QA only. Leave "false" in staging and production. ---
# When true, requests can set identity via x-test-role / x-test-company-id /
# x-test-candidate-session-id headers, bypassing real auth entirely.
ENABLE_TEST_HEADERS=false
